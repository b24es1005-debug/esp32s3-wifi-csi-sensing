# Ensure model checkpoints and large artifacts are ignored by default, keep final exported model
models/*.ckpt
models/*.pth
models/*.pt
models/checkpoints/
data/raw/**
data/processed/**
data/datasets/**
!data/**/.gitkeep
!data/csi_synthetic_demo.csv

# Keep the single exported/packaged model used for inference, but ignore other models
!ml/models/activity_model.pkl

